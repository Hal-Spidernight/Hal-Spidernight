{
  "name": "hal-spidernight",
  "version": "0.1.0",
  "description": "Hal's GitHub profile card — run with `npx hal-spidernight`",
  "type": "module",
  "bin": {
    "hal-spidernight": "./bin/cli.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hal-Spidernight/Hal-Spidernight.git"
  },
  "bugs": {
    "url": "https://github.com/Hal-Spidernight/Hal-Spidernight/issues"
  },
  "homepage": "https://hal-spidernight.void.app/",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "bun bin/cli.js",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "postversion": "npm publish && git push --follow-tags"
  },
  "keywords": [
    "profile",
    "card",
    "cli",
    "npx",
    "github"
  ],
  "author": "Hal",
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
